{
  "name": "gamehub-van-phong",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @gamehub/web --filter @gamehub/server dev",
    "build": "pnpm -r build",
    "start": "node apps/server/dist/index.js",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "tsx scripts/smoke.ts",
    "test:phase1": "pnpm build && tsx scripts/phase1.ts",
    "test:phase1:long": "pnpm build && tsx scripts/phase1.ts --long",
    "test:phase4": "pnpm build && tsx scripts/phase4.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.10.0",
    "eslint": "^9.39.0",
    "prettier": "^3.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0",
    "tsx": "^4.21.0",
    "vitest": "^4.0.0",
    "socket.io-client": "^4.8.1"
  }
}
