# Replace the domain and certificate paths with your VPS configuration.
server {
    listen 80;
    server_name gamehub.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name gamehub.example.com;
    ssl_certificate /etc/letsencrypt/live/gamehub.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/gamehub.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 75s;
    }
}
